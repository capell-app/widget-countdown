{
    "manifest-version": 3,
    "name": "capell-app/widget-countdown",
    "slug": "widget-countdown",
    "displayName": "Countdown Widget",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "IANA timezone countdowns with normalized UTC targets, an absolute time fallback, and low-frequency announcements.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\WidgetCountdown",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\WidgetCountdown\\Providers\\WidgetCountdownServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "content-widget",
            "key": "capell-app.countdown",
            "class": "Capell\\WidgetCountdown\\WidgetCountdownContribution"
        },
        {
            "type": "asset",
            "key": "resource-group:capell-app.widget-countdown",
            "class": "Capell\\WidgetCountdown\\WidgetCountdownContribution"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "setupParams": [],
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["frontend.public-static"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 5,
        "adminQueryBudget": 0,
        "cacheTags": ["widget-countdown"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale", "theme"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "widget-countdown.package-health",
            "label": "Countdown widget package health",
            "class": "Capell\\WidgetCountdown\\Health\\WidgetCountdownHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Accessible timezone-safe countdowns with durable absolute-time fallbacks.",
        "description": "Count down to a launch, event, offer or deadline. Editors enter an IANA timezone and a target, and visitors always see the absolute time before JavaScript turns it into a live timer. Requires Layout Builder. Limits: announcements to assistive technology update at most once a minute, and visual seconds stay hidden from assistive technology.",
        "problem": "Visitors may miss an approaching deadline when a page only shows a static date.",
        "outcome": "A page has a countdown to the configured target time.",
        "faq": [
            {
                "question": "How is the target time interpreted?",
                "answer": "Editors set an IANA timezone and the target is normalised to UTC."
            },
            {
                "question": "What appears during the countdown?",
                "answer": "The public page shows remaining time and includes time-change announcements."
            },
            {
                "question": "Can a countdown include an action?",
                "answer": "Yes. Editors can add an optional call to action."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-countdown-public-output.png",
                "alt": "Countdown public output",
                "caption": "Countdown public output"
            },
            {
                "path": "docs/assets/marketplace/listing-countdown-layout-builder-editor.png",
                "alt": "Countdown fields in Layout Builder",
                "caption": "Countdown fields in Layout Builder"
            },
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Countdown widget preview",
                "caption": "Countdown widget"
            }
        ],
        "categories": ["foundation", "frontend", "events"]
    }
}
