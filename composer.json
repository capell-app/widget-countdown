{
    "name": "capell-app/widget-countdown",
    "description": "Timezone-safe accessible countdown widget for Capell.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^0.0",
        "capell-app/core": "^0.0",
        "capell-app/frontend": "^0.0",
        "capell-app/layout-builder": "^0.0",
        "spatie/laravel-package-tools": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\WidgetCountdown\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\WidgetCountdown\\Providers\\WidgetCountdownServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
